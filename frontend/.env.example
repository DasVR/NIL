# Copy to .env.local (gitignored) and fill in values for your own machine.
# .env.local is never committed — this file only documents the shape.

# Absolute path to the NIL repo root on THIS machine, used only by the
# sv-agentation dev inspector (click an element -> jump to its source file).
# Leave unset and the inspector still works for annotation/copy, just without
# the "open in editor" jump.
VITE_WORKSPACE_ROOT=/absolute/path/to/NIL

# API origin for the client; defaults to same-origin /v1 (dev proxy / desktop).
# VITE_API_BASE=https://nil-api.dasdev.net/v1
