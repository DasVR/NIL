FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    docker.io \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml requirements.txt ./
RUN pip install --no-cache-dir -e .

COPY . .

RUN mkdir -p /root/.finn-pentest/engagements /root/.finn-pentest/sandboxes /root/.finn-pentest/plugins /root/.finn-pentest/prompts /root/.finn-pentest/wordlists

EXPOSE 8766

CMD ["python", "main.py"]