{
  "name": "finn-desktop",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "setup": "npm --prefix ../web install && npm install",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:windows": "tauri build --target x86_64-pc-windows-msvc",
    "build:macos": "tauri build --target universal-apple-darwin",
    "build:macos:app": "tauri build --bundles app && bash scripts/macos-zip-app.sh",
    "build:linux": "tauri build --target x86_64-unknown-linux-gnu"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.7"
  }
}
