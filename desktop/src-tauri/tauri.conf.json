{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Finn Pentest Harness",
  "version": "0.2.0",
  "identifier": "ai.finn.pentest",
  "build": {
    "frontendDist": "../../web/build",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm --prefix ../web run dev",
    "beforeBuildCommand": "npm --prefix ../web run build"
  },
  "app": {
    "windows": [
      {
        "title": "Finn Pentest Harness",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  },
  "plugins": {
    "notification": {},
    "global-shortcut": {}
  }
}
