<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- JIT / executable memory required for the embedded Chromium webview -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Ad-hoc signed / unsigned local helper binaries used by pentest tooling -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Network: UI talks to local FastAPI backend and to targets you scan -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>

  <!-- Files and folders: read pentest scripts/configs, write reports in ~/finn -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>

  <!-- USB/network interface access for packet-related tooling (optional, denied silently if unavailable) -->
  <key>com.apple.security.device.usb</key>
  <true/>

  <!-- No automatic administrator privileges. Elevation is only requested after
       explaining why, and only when a non-elevated alternative has failed. -->
</dict>
</plist>
